{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SakuraiTsubaki/Sakurai/derived/generation-06/battle-sprites/gen3-insertion/BATTLE_MASTER_V1/manifest.schema.json",
  "title": "Generation VI to Generation III Battle Sprite Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "logical_id",
    "source_identity",
    "visual_state",
    "target_role",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "logical_id": {
      "type": "string",
      "minLength": 1
    },
    "source_identity": {
      "type": "object",
      "required": [
        "generation",
        "game",
        "upstream_repository",
        "region",
        "language",
        "revision",
        "source_type"
      ],
      "properties": {
        "generation": {
          "const": 6
        },
        "game": {
          "enum": [
            "X",
            "Y",
            "OmegaRuby",
            "AlphaSapphire"
          ]
        },
        "upstream_repository": {
          "enum": [
            "PocketMonsters-X-Decompilation",
            "PocketMonsters-Y-Decompilation",
            "PocketMonsters-OmegaRuby-Decompilation",
            "PocketMonsters-AlphaSapphire-Decompilation"
          ]
        },
        "region": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "source_type": {
          "enum": [
            "game-model",
            "verified-extraction",
            "official-render",
            "in-game-capture",
            "official-web-asset",
            "preservation-mirror",
            "reconstructed",
            "unknown"
          ]
        }
      },
      "additionalProperties": true
    },
    "pokemon": {
      "type": "object",
      "required": [
        "national_dex",
        "species",
        "form",
        "gender_state"
      ],
      "properties": {
        "national_dex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 721
        },
        "species": {
          "type": "string"
        },
        "form": {
          "type": "string"
        },
        "gender_state": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "archive_source": {
      "type": "object",
      "properties": {
        "archive_path": {
          "type": "string"
        },
        "member_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "member_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "detected_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_extension": {
          "type": [
            "string",
            "null"
          ]
        },
        "container_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "compression": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        }
      },
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "shared_geometry_group": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "textures": {
      "type": "object",
      "properties": {
        "normal": {
          "$ref": "#/$defs/source_asset"
        },
        "shiny": {
          "$ref": "#/$defs/source_asset"
        },
        "auxiliary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_asset"
          }
        }
      },
      "additionalProperties": true
    },
    "animation": {
      "type": "object",
      "properties": {
        "skeletal": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_asset"
          }
        },
        "material": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_asset"
          }
        },
        "visibility": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_asset"
          }
        },
        "canonical_motion_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_timestamp": {
          "type": [
            "number",
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "visual_state": {
      "type": "object",
      "required": [
        "palette_state",
        "view"
      ],
      "properties": {
        "palette_state": {
          "enum": [
            "normal",
            "shiny"
          ]
        },
        "view": {
          "enum": [
            "front",
            "back"
          ]
        },
        "pose_status": {
          "enum": [
            "verified",
            "provisional",
            "unresolved"
          ]
        },
        "camera_status": {
          "enum": [
            "verified",
            "provisional",
            "unresolved"
          ]
        }
      },
      "additionalProperties": true
    },
    "canonical_render": {
      "type": "object",
      "properties": {
        "width": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "height": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "projection": {
          "type": [
            "string",
            "null"
          ]
        },
        "camera_parameters": {
          "type": [
            "object",
            "null"
          ]
        },
        "model_transform": {
          "type": [
            "object",
            "null"
          ]
        },
        "anchor": {
          "type": [
            "object",
            "null"
          ]
        },
        "png_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        }
      },
      "additionalProperties": true
    },
    "palette_reconstruction": {
      "type": "object",
      "properties": {
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "semantic_roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "source_evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 15
              }
            },
            "additionalProperties": true
          }
        },
        "palette_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        }
      },
      "additionalProperties": true
    },
    "target_role": {
      "type": "object",
      "required": [
        "canvas_width",
        "canvas_height",
        "bpp",
        "front_back",
        "normal_shiny"
      ],
      "properties": {
        "canvas_width": {
          "const": 64
        },
        "canvas_height": {
          "const": 64
        },
        "bpp": {
          "const": 4
        },
        "front_back": {
          "enum": [
            "front",
            "back"
          ]
        },
        "normal_shiny": {
          "enum": [
            "normal",
            "shiny"
          ]
        },
        "automatic_png_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_png_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "palette_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "four_bpp_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "compressed_graphics_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "hashes": {
      "type": "object",
      "properties": {
        "canonical_render_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "automatic_png_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "final_png_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "final_rendered_pixels_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "final_palette_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "final_4bpp_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "final_compressed_sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        }
      },
      "additionalProperties": true
    },
    "manual_correction": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "reason"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "old_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 15
              },
              "new_index": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 15
              },
              "reason": {
                "type": "string"
              },
              "source_evidence": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "dedup": {
      "type": "object",
      "properties": {
        "rendered_pixel_key": {
          "$ref": "#/$defs/sha256_or_unresolved"
        },
        "canonical_logical_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": [
        "level",
        "final_master_eligible"
      ],
      "properties": {
        "level": {
          "enum": [
            "confirmed-game-data",
            "confirmed-public",
            "reported-public",
            "provisional",
            "unresolved"
          ]
        },
        "final_master_eligible": {
          "type": "boolean"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "sha256_or_unresolved": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "enum": [
            "unresolved",
            "not-applicable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "source_asset": {
      "type": "object",
      "properties": {
        "archive_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256_or_unresolved"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
